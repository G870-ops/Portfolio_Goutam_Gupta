# Vercel Frontend Environment Variables
# Copy this to .env.local for local development
# In Vercel dashboard: Settings → Environment Variables → add these

# Your deployed backend URL on Vercel (set after backend is deployed)
# Example: https://portfolio-backend-goutam.vercel.app/api
VITE_API_BASE_URL=https://your-backend-project.vercel.app/api

# Your personal LinkedIn profile URL
# Example: https://www.linkedin.com/in/your-custom-linkedin-id
VITE_LINKEDIN_URL=https://www.linkedin.com/in/your-actual-id
